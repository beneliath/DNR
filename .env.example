# Docker secrets are files, not values stored in this environment file.
DNR_MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
DNR_MYSQL_APP_PASSWORD_FILE=./secrets/mysql_app_password
DNR_MYSQL_BACKUP_PASSWORD_FILE=./secrets/mysql_backup_password
DNR_MYSQL_MAINTENANCE_PASSWORD_FILE=./secrets/mysql_maintenance_password
DNR_MYSQL_GEOCODER_PASSWORD_FILE=./secrets/mysql_geocoder_password
DNR_MYSQL_MAIL_INGEST_PASSWORD_FILE=./secrets/mysql_mail_ingest_password
DNR_MYSQL_MAIL_DISPATCH_PASSWORD_FILE=./secrets/mysql_mail_dispatch_password
DNR_2FA_KEY_FILE=./secrets/dnr_2fa_encryption_key
DNR_BACKUP_PASSWORD_FILE=./secrets/backup_password

# The secure production default requires TLS forwarded by a trusted proxy.
DNR_REQUIRE_HTTPS=1
DNR_BIND_ADDRESS=127.0.0.1
PORT=8080
DNR_PUBLIC_BASE_URL=https://dnr.example.org

# Ubuntu/Traefik deployment. Keep DNR_TRAEFIK_ENABLE=false while staging;
# enable it only when the old Traefik file-provider route is removed.
DNR_PUBLIC_HOSTNAME=moed.beneliath.com
DNR_TRAEFIK_ENABLE=false
DNR_EDGE_NETWORK=moed_edge
DNR_EDGE_SUBNET=172.29.255.0/29
DNR_EDGE_TRAEFIK_IP=172.29.255.2
DNR_EDGE_INGRESS_IP=172.29.255.3
DNR_CLOUDFLARED_PROXY_IP=172.18.0.254

# Account invitations, email verification, password recovery, and optional
# daily work digests. The SMTP overlay mounts DNR_SMTP_PASSWORD_SECRET_FILE
# only into the delivery worker;
# DNR_SMTP_PASSWORD is available only for simple non-Compose deployments.
DNR_MAIL_TRANSPORT=disabled
DNR_MAIL_FROM=moed@example.org
DNR_MAIL_FROM_NAME=MOED
DNR_SMTP_HOST=smtp.example.org
DNR_SMTP_PORT=587
DNR_SMTP_ENCRYPTION=starttls
DNR_SMTP_USERNAME=
DNR_SMTP_PASSWORD=
DNR_SMTP_PASSWORD_SECRET_FILE=./secrets/smtp_password
# Optional custom SMTP trust anchor. Use only with an *-smtp-ca Compose mode.
DNR_SMTP_CA_SECRET_FILE=./secrets/smtp_ca.pem
DNR_SMTP_PEER_NAME=
DNR_EMAIL_OUTBOX_BATCH_SIZE=20
DNR_EMAIL_OUTBOX_IDLE_SECONDS=15
DNR_NOTIFICATION_OUTBOX_BATCH_SIZE=20
DNR_NOTIFICATION_SCHEDULE_INTERVAL_SECONDS=300
DNR_TASK_DIGEST_HOUR=7

# Proton SMTP Submission is preferred for outbound delivery on the Ubuntu
# deployment. Create a Proton SMTP token and store it in smtp_password.
# DNR_SMTP_HOST=smtp.protonmail.ch
# DNR_SMTP_PORT=587
# DNR_SMTP_ENCRYPTION=starttls

# Optional inbound Chron-mail worker. This is enabled only by the
# development-mail or production-mail Compose mode. The password file must
# contain the configured IMAP account password and remain outside version
# control. See README.md before connecting Proton Mail Bridge.
DNR_INBOUND_ADDRESS=moed@beneliath.com
DNR_INBOUND_MAX_BYTES=10485760
DNR_INBOUND_BATCH_SIZE=20
DNR_INBOUND_IDLE_SECONDS=30
DNR_IMAP_HOST=
DNR_IMAP_PORT=1143
DNR_IMAP_SECURITY=starttls
DNR_IMAP_VERIFY_PEER=1
DNR_IMAP_USERNAME=
DNR_IMAP_PASSWORD_FILE=./secrets/imap_password
DNR_IMAP_MAILBOX=INBOX

# The Ubuntu Proton Bridge sidecar supplies these endpoint values itself.
# Set DNR_IMAP_USERNAME to the generated Bridge username and put its generated
# password (not the Proton account password) in secrets/imap_password.
PROTON_BRIDGE_VERSION=3.25.0-1
PROTON_BRIDGE_SHA256=6b0318f4f425ef1a19b63e2bd589bc1036d95f073cb9ac26b42c0fc63a8bc275

# Narrow these values to the actual proxy hops used by the deployment.
DNR_TRUSTED_PROXY_IPS=192.168.65.1
DNR_TRUSTED_CLOUDFLARE_PROXY_IPS=172.18.0.0/24
DNR_BACKEND_SUBNET=172.30.255.0/24
DNR_INGRESS_PROXY_IP=172.30.255.254
DNR_TIMEZONE=America/Chicago

# The background geocoder permits only explicit public HTTPS hosts.
DNR_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
DNR_GEOCODER_ALLOWED_HOSTS=nominatim.openstreetmap.org
DNR_GEOCODER_USER_AGENT=MOED (https://dnr.example.org; admin@example.org)

# Immutable footer provenance is derived automatically by
# scripts/compose_with_provenance.sh. CI source archives without .git may
# provide both values explicitly instead.
DNR_BUILD_COMMIT=
DNR_BUILD_TIMESTAMP=
