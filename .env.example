# Generate independent random values, for example with: openssl rand -base64 36
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DNR_CALENDAR_TOKEN=

# The secure default listens only on this machine. Set an explicit LAN address
# only when a TLS reverse proxy and firewall protect the service.
DNR_BIND_ADDRESS=127.0.0.1
PORT=8080
DNR_PUBLIC_BASE_URL=https://dnr.example.org
