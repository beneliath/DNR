# Docker secrets are files, not values stored in this environment file.
DNR_MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
DNR_MYSQL_APP_PASSWORD_FILE=./secrets/mysql_app_password
DNR_MYSQL_MAINTENANCE_PASSWORD_FILE=./secrets/mysql_maintenance_password
DNR_2FA_KEY_FILE=./secrets/dnr_2fa_encryption_key
DNR_BACKUP_PASSWORD_FILE=./secrets/backup_password

# The secure production default requires TLS forwarded by a trusted proxy.
DNR_REQUIRE_HTTPS=1
DNR_BIND_ADDRESS=127.0.0.1
PORT=8080
DNR_PUBLIC_BASE_URL=https://dnr.example.org

# Narrow these values to the actual proxy hops used by the deployment.
DNR_TRUSTED_PROXY_IPS=192.168.65.1
DNR_TRUSTED_CLOUDFLARE_PROXY_IPS=172.18.0.0/24
DNR_BACKEND_SUBNET=172.30.255.0/24
DNR_INGRESS_PROXY_IP=172.30.255.254
DNR_TIMEZONE=America/Chicago

# The background geocoder permits only explicit public HTTPS hosts.
DNR_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
DNR_GEOCODER_ALLOWED_HOSTS=nominatim.openstreetmap.org
DNR_GEOCODER_USER_AGENT=MOED (https://dnr.example.org; admin@example.org)

# Immutable footer provenance is derived automatically by
# scripts/compose_with_provenance.sh. CI source archives without .git may
# provide both values explicitly instead.
DNR_BUILD_COMMIT=
DNR_BUILD_TIMESTAMP=
