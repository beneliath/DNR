      "guidance_rules": [
        {
          "modes": [
            "explain",
            "troubleshoot",
            "perform"
          ],
          "patterns": [
            "\\b(receipt|expense|reimbursement)\\b",
            "\\b(limit|size|large|mb|many|maximum)\\b"
          ],
          "source": "manual-topic-reimbursements-add-an-expense-and-receipts",
          "message": "An expense allows up to 20 receipts totaling 15 MB. Supported formats are JPEG, PNG, WebP, and PDF. A request allows up to 100 receipts and 25 MB of originals. Only its ZIP is emailed; the full email must fit within 25 MB including Base64 encoding, headers, and body, so the ZIP is capped at 18 MB. The submission review meter reaches 100% at 18 MB and also shows the total encoded email size. Split a large request or reduce source image sizes.",
          "question": ""
        },
        {
          "modes": [
            "explain",
            "troubleshoot",
            "perform"
          ],
          "patterns": [
            "\\b(receipt|expense|reimbursement)\\b",
            "\\b(submitted|locked)\\b",
            "\\b(edit|delete|remove|change|unlock)\\b"
          ],
          "source": "manual-topic-reimbursements-track-delivery-and-handle-corrections",
          "message": "Submitted expenses and receipts stay locked, including for administrators. Open the submitted request and record a correction, then coordinate with the bookkeeper. A correction does not recall sent mail or free the expenses for another request.",
          "question": ""
        }
      ]
    },
