{
    "name": "beneliath/dnr",
    "description": "DNR engagement management application",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dnr\\": "src/app/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "endroid/qr-code": "^6.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "spomky-labs/otphp": "^11.4",
        "symfony/yaml": "^7.3",
        "tecnickcom/tcpdf": "^6.11",
        "zbateson/mail-mime-parser": "^4.0.3"
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "lint": "sh scripts/lint_php.sh",
        "analyse": [
            "phpstan analyse --no-progress --debug --memory-limit=512M",
            "phpstan analyse --configuration=phpstan-helpers.neon --no-progress --debug --memory-limit=512M",
            "phpstan analyse --configuration=phpstan-modern-routes.neon --no-progress --debug --memory-limit=512M",
            "phpstan analyse --configuration=phpstan-routes.neon --no-progress --debug --memory-limit=512M"
        ],
        "test": "sh scripts/run_tests.sh",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
