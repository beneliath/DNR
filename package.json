{
  "name": "dnr-frontend-assets",
  "private": true,
  "scripts": {
    "build:pdfjs": "node scripts/build-pdfjs-assets.mjs",
    "build:css": "node scripts/build-frontend-assets.mjs css",
    "build:js": "node scripts/build-frontend-assets.mjs js",
    "build:manifest": "node scripts/build-asset-manifest.mjs",
    "build:assets": "npm run build:css && npm run build:js && npm run build:pdfjs && npm run build:manifest",
    "check:js": "node scripts/check-js-syntax.mjs",
    "test:js": "node --test tests/js/*.test.js",
    "test": "npm run build:assets && npm run check:js && npm run test:js"
  },
  "devDependencies": {
    "chart.js": "^4.6.1",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "maplibre-gl": "6.15.0"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
