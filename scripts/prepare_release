#!/usr/bin/env python3
"""Deterministic release preparation; minor/major/super follow this project's vocabulary."""
import argparse
import json
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent

def git(*args):
    return subprocess.check_output(['git', '-C', str(ROOT), *args], text=True).strip()

def version(value):
    if not re.fullmatch(r'(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)', value):
        raise ValueError('Invalid x.y.z release version: ' + value)
    return tuple(map(int, value.split('.')))

def bump(value, kind):
    parts = list(version(value))
    index = {'super': 0, 'major': 1, 'minor': 2}[kind]
    parts[index] += 1
    for following in range(index + 1, 3):
        parts[following] = 0
    return '.'.join(map(str, parts))

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['minor', 'major', 'super', 'check'])
    parser.add_argument('--base-ref', default='origin/main')
    parser.add_argument('--plugin-bump', choices=['minor', 'major', 'super'])
    args = parser.parse_args()
    base = git('show', args.base_ref + ':VERSION')
    current = (ROOT / 'VERSION').read_text().strip()
    version(current)
    allowed = {base, *(bump(base, kind) for kind in ('minor', 'major', 'super'))}
    if current not in allowed:
        raise ValueError('VERSION is stale or is not one permitted bump from ' + args.base_ref)
    if args.action != 'check':
        target = bump(base, args.action)
        if current not in (base, target):
            raise ValueError('A different release bump is already prepared')
    manifest_path = ROOT / 'mattermost-plugin/plugin.json'
    manifest = json.loads(manifest_path.read_text())
    version(manifest['version'])
    if args.plugin_bump:
        if args.action == 'check':
            raise ValueError('--plugin-bump cannot mutate during check')
        base_plugin = json.loads(git('show', args.base_ref + ':mattermost-plugin/plugin.json'))['version']
        target_plugin = bump(base_plugin, args.plugin_bump)
        if manifest['version'] not in (base_plugin, target_plugin):
            raise ValueError('A different plugin bump is already prepared')
        manifest['version'] = target_plugin
    # Validate both version transitions before writing either file.
    if args.action != 'check':
        (ROOT / 'VERSION').write_text(target + '\n')
        if args.plugin_bump:
            manifest_path.write_text(json.dumps(manifest, indent=2) + '\n')
    command = ['php', str(ROOT / 'scripts/generate_daily_digest_preview.php')]
    if args.action == 'check':
        command.append('--check')
    subprocess.run(command, cwd=ROOT, check=True)
    subprocess.run(['php', str(ROOT / 'tests/migration_integrity_test.php')], cwd=ROOT, check=True)
    print('Release metadata valid: application ' + (ROOT / 'VERSION').read_text().strip()
          + ', plugin ' + manifest['version'])
    if args.action != 'check':
        subprocess.run(['git', 'diff', '--stat'], cwd=ROOT, check=True)
        print('Review the release diff, then merge through protected main; no tag or push was performed.')

if __name__ == '__main__':
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error))
