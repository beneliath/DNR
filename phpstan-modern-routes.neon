parameters:
    # Routes moved onto explicit connection and request boundaries graduate
    # here before the remaining procedural surface is raised as a whole.
    level: 3
    paths:
        - src/speaker_photo.php
        - src/speakers.php
        - src/edit_speaker.php
        - src/view_speaker.php
        - src/map_geocode.php
        - src/map_pin.php
        - src/dashboard.php
        - src/organization_contacts.php
        - src/engagement_reschedule_options.php
        - src/task_subject_search.php
        - src/user_lifecycle.php
        - src/restore_presentations.php
        - src/view_calendar.php
        - src/contacts.php
        - src/organizations.php
        - src/engagements.php
        - src/tasks.php
        - src/audit_log.php
        - src/map.php
        - src/inbound_mail.php
        - src/inbound_engagement_search.php
        - src/inquiries.php
        - src/add_inquiry.php
        - src/edit_inquiry.php
        - src/view_inquiry.php
        - src/compose_inquiry_email.php
        - src/convert_inquiry.php
    bootstrapFiles:
        - src/functions.php
    scanFiles:
        - src/speaker_helpers.php
        - src/short_link_helpers.php
        - src/engagement_view_helpers.php
        - src/inbound_queue_helpers.php
        - src/record_workspace_helpers.php
        - src/config.php
        - src/calendar_helpers.php
        - src/booking_inquiry_helpers.php
        - src/chron_log_helpers.php
        - src/contact_photo_helpers.php
        - src/contact_organization_helpers.php
        - src/dashboard_helpers.php
        - src/engagement_contact_helpers.php
        - src/engagement_lifecycle_helpers.php
        - src/engagement_search_helpers.php
        - src/follow_up_task_helpers.php
        - src/financial_report_helpers.php
        - src/map_helpers.php
        - src/notification_helpers.php
        - src/pagination_helpers.php
        - src/presentation_helpers.php
        - src/presentation_asset_helpers.php
        - src/image_upload_helpers.php
        - src/inbound_email_helpers.php
        - src/two_factor_helpers.php
        - src/user_lifecycle_helpers.php
    tmpDir: /tmp/dnr-phpstan-modern-routes
    parallel:
        maximumNumberOfProcesses: 1
